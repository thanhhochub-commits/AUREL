   preview=`<div class="section-top top-gap"><h2>Kết quả nhóm PDF</h2><small>${previews.length} tài liệu đã phân tích</small></div><div class="dataset-cards">${summaries}</div>${warnings.map(w=>`<div class="note">${escapeHTML(w)}</div>`).join('')}${missing.map(w=>`<div class="note warn">${escapeHTML(w)}</div>`).join('')}${wrapTable(['Chọn','Tệp PDF','Bank','Year','metric_id','metric_name','value','unit','page_source','Nguồn PDF'],rows)}<div class="hrow top-gap" style="flex-wrap:wrap"><button class="button" id="pdf-metric-all">Chọn toàn bộ chỉ tiêu đọc được</button><button class="button" id="pdf-metric-none">Bỏ chọn chỉ tiêu</button><label class="checkbox"><input type="checkbox" id="pdf-replace" checked> Cập nhật chỉ tiêu cùng ngân hàng/năm nếu đã có</label></div><button class="button teal top-gap" id="pdf-commit">Xác nhận và nạp chỉ tiêu đã chọn từ ${previews.length} PDF</button><div id="pdf-commit-feedback"></div>`;
