   const f2=$('#upload-feedback');if(f2)f2.innerHTML=`<div class="note ${failed.length?'warn':''}"><strong>${escapeHTML(summary)}</strong>${failed.map(x=>`<br>${escapeHTML(x.name)}: ${escapeHTML(x.error)}`).join('')}</div>`;toast(summary,Boolean(failed.length&& !ok.length));
