        with STORE.lock:
            parsed=parse_rows(raw,STORE.rows,replace=replace,file_name=name)
            new_keys={(r['bank'],r['year'],r['metric_id']) for r in parsed}
            STORE.rows=[r for r in STORE.rows if (r['bank'],r['year'],r['metric_id']) not in new_keys]+parsed
