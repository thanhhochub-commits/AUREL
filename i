async function analyzePdf(name){return analyzeSelectedPdfs(name?[name]:null)}
async function analyzeSelectedPdfs(explicitNames=null){
 const btn=$('#pdf-run');if(btn)btn.disabled=true;
 const feed=$('#pdf-extract-feedback');
 let names=(explicitNames||pdfSelectedNames()).filter(Boolean);names=[...new Set(names)];
 if(!names.length){if(btn)btn.disabled=false;return toast('Hãy chọn ít nhất một PDF để phân tích.',true)}

 app.pdfPreviews=[];app.pdfPreview=null;app.pdfJobIds={};app.pdfBatchStatus={};
 const saved=[],failed=[];
 if(feed)feed.innerHTML='<div class="note"><strong>EXACT16 V13</strong>: bắt đầu File 1/'+names.length+'. Mỗi file sẽ được lưu xong trước khi file kế tiếp được OCR.</div>';
 try{
   for(let i=0;i<names.length;i++){
     const source=names[i];
     app.pdfBatchStatus[source]={status:'queued',progress:0,message:`File ${i+1}/${names.length}: chuẩn bị OCR`};
     if(feed)feed.innerHTML=pdfBatchProgressHtml(app.pdfBatchStatus);
     try{
       // IMPORTANT: start only ONE job here. Do not start the next PDF until this one is committed.
       const started=await request('api/pdf/analyze/start',{name:source,bank:'',year:null,unit:'auto'},25000);
       const jid=started.job_id;app.pdfJobIds={};app.pdfJobIds[source]=jid;
       app.pdfBatchStatus[source]={status:started.status||'queued',progress:Number(started.progress||0),message:started.message||'Đã xếp hàng OCR'};
       const deadline=Date.now()+15*60*1000;let result=null,error=null;
       while(Date.now()<deadline){
         await new Promise(resolve=>setTimeout(resolve,900));
         let st;try{st=await request(`api/pdf/job?id=${encodeURIComponent(jid)}`,null,18000)}catch(e){st={status:'error',progress:0,message:e.message,error:e.message}}
         app.pdfBatchStatus[source]={status:st.status,progress:Number(st.progress||0),message:`File ${i+1}/${names.length}: ${st.message||''}`,error:st.error||''};
         if(feed)feed.innerHTML=pdfBatchProgressHtml(app.pdfBatchStatus);
         if(st.status==='done'){result=st.result;break}
         if(st.status==='error'){error=st.error||st.message||'OCR lỗi';break}
       }
       if(!result){throw Error(error||`File ${i+1} OCR quá 15 phút.`)}
       const metrics=(result.items||[]).map(x=>x.metric_id);
       if(!metrics.length)throw Error('Không đọc được chỉ tiêu nào từ PDF này; không có dữ liệu để lưu.')
       // Commit NOW. This increments datastore revision and invalidates this preview before the next PDF starts.
       // Therefore data from two PDFs can never share/mix the same preview revision.
       const committed=await request('api/pdf/commit',{preview_token:result.preview_token,metrics,replace:true},60000);
       app.state=committed.state||app.state;
       saved.push({source,bank:result.bank,year:result.year,count:metrics.length,missing:(result.missing||[]).length});
       app.pdfBatchStatus[source]={status:'saved',progress:100,message:`File ${i+1}/${names.length}: đã lưu ${metrics.length}/16 chỉ tiêu · ${result.bank} ${result.year}`};
       if(feed)feed.innerHTML=pdfBatchProgressHtml(app.pdfBatchStatus);
     }catch(e){
       const message=(e&&e.message)?e.message:String(e||'Lỗi không xác định');
       failed.push({source,error:message});
       app.pdfBatchStatus[source]={status:'error',progress:0,message:`File ${i+1}/${names.length}: ${message}`,error:message};
       if(feed)feed.innerHTML=pdfBatchProgressHtml(app.pdfBatchStatus);
       // Deliberately continue to the next selected PDF. One broken document must not erase prior saved files.
     }
   }
   app.pdfJobIds={};app.pdfPreviews=[];app.pdfPreview=null;
   const last=saved[saved.length-1];if(last){app.bank=last.bank;app.year=last.year}
   await refresh();
   const okText=saved.map((x,i)=>`${i+1}. ${x.source}: ${x.count}/16 · ${x.bank} ${x.year}`).join(' | ');
   if(saved.length)toast(`Đã đọc và lưu tuần tự ${saved.length}/${names.length} PDF. ${okText}`);
