     const f=files[i];try{const out=await uploadOneFile(f,replace,feed,i+1,files.length);ok.push({name:f.name,message:out.message})}catch(e){failed.push({name:f.name,error:e.message});if(feed)feed.innerHTML=`<div class="note warn">${escapeHTML(f.name)}: ${escapeHTML(e.message)}<br>Hệ thống tiếp tục với các tệp còn lại…</div>`}
