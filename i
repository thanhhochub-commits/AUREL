async function uploadOneFile(f,replace,feed,index,total){
 if(f.size>40*1024*1024)throw Error(`${f.name}: dung lượng vượt 40 MB.`);
 const bytes=new Uint8Array(await f.arrayBuffer()),isPdf=/\.pdf$/i.test(f.name);let out=null;
 const prefix=`[${index}/${total}] ${escapeHTML(f.name)}`;
 if(isPdf||bytes.length>512*1024){
   if(!window.crypto?.subtle)throw Error('Trình duyệt không hỗ trợ SHA-256 để tải tệp theo từng phần.');
   const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))).map(x=>x.toString(16).padStart(2,'0')).join('');
   const init=await request('api/upload/start',{name:f.name,size:bytes.length,sha256:digest,replace},25000),n=init.chunk_bytes;
   for(let offset=0;offset<bytes.length;offset+=n){const slice=bytes.subarray(offset,Math.min(offset+n,bytes.length));let binary='';for(let i=0;i<slice.length;i++)binary+=String.fromCharCode(slice[i]);await request('api/upload/chunk',{upload_id:init.upload_id,offset,base64:btoa(binary)},30000);if(feed){const pct=Math.round(100*Math.min(offset+slice.length,bytes.length)/bytes.length);feed.innerHTML=`<div class="note">${prefix} · đang tải ${pct}%<br><span class="tiny">Đã hoàn tất ${index-1}/${total} tệp trước đó.</span></div>`}}
   out=await request('api/upload/complete',{upload_id:init.upload_id},50000);
 }else{
   let binary='';for(let i=0;i<bytes.length;i++)binary+=String.fromCharCode(bytes[i]);
   try{out=await request('api/upload',{name:f.name,base64:btoa(binary),replace},50000)}catch(primary){
     if(!window.crypto?.subtle)throw primary;const digest=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes))).map(x=>x.toString(16).padStart(2,'0')).join('');const init=await request('api/upload/start',{name:f.name,size:bytes.length,sha256:digest,replace},25000),n=init.chunk_bytes;for(let offset=0;offset<bytes.length;offset+=n){const slice=bytes.subarray(offset,Math.min(offset+n,bytes.length));let part='';for(let i=0;i<slice.length;i++)part+=String.fromCharCode(slice[i]);await request('api/upload/chunk',{upload_id:init.upload_id,offset,base64:btoa(part)},30000)}out=await request('api/upload/complete',{upload_id:init.upload_id},50000);
   }
 }
 return out;
}
