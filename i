function syncScenarioControl(kind,source){
  const range=$('#'+kind+'-slider'),number=$('#'+kind+'-input'),preview=$('#'+kind+'-preview'),error=$('#'+kind+'-error');
  if(!range||!number||!preview||!error)return;
  if(source==='slider') number.value=range.value;
  const raw=number.value.trim(),v=Number(raw),min=Number(number.min),max=Number(number.max);
  const valid=raw!==''&&Number.isFinite(v)&&v>=min&&v<=max&&Number.isInteger(v);
  if(!valid){
    number.setAttribute('aria-invalid','true');preview.textContent='Cần điều chỉnh';
    error.textContent='Nhập số nguyên từ '+min+'% đến +'+max+'%.';
  }else{
    number.removeAttribute('aria-invalid');error.textContent='';
    range.value=String(v);range.style.setProperty('--slider-fill',100*(v-min)/(max-min)+'%');
    preview.textContent=(v>0?'+':'')+v+'%';
  }
  const run=$('#run-scenario');if(run)run.disabled=['npl','loan'].some(k=>{
    const n=$('#'+k+'-input');if(!n)return true;const x=Number(n.value);
    return n.value.trim()===''||!Number.isFinite(x)||x<Number(n.min)||x>Number(n.max)||!Number.isInteger(x);
  });
}
