async function commitPdf(){
 const previews=app.pdfPreviews||[];if(!previews.length)return;
 const checks=Array.from(document.querySelectorAll('.pdf-metric-batch:checked'));if(!checks.length)return toast('Hãy chọn ít nhất một chỉ tiêu để nạp.',true);
 const grouped=new Map();for(const c of checks){const token=c.dataset.token,metric=c.dataset.metric;if(!grouped.has(token))grouped.set(token,[]);grouped.get(token).push(metric)}
 const selections=Array.from(grouped,([preview_token,metrics])=>({preview_token,metrics}));
 if(!confirm(`Xác nhận nạp ${checks.length} chỉ tiêu đã chọn từ ${selections.length} PDF vào bộ dữ liệu? Các chỉ tiêu trùng ngân hàng/năm sẽ được cập nhật bằng bản bạn vừa xác nhận.`))return;
 const btn=$('#pdf-commit');if(btn)btn.disabled=true;
 try{
   const r=await request('api/pdf/commit/batch',{selections,replace:Boolean($('#pdf-replace')?.checked)},60000);
   const last=previews[previews.length-1]?.result;app.pdfPreviews=[];app.pdfPreview=null;app.pdfBatchStatus={};if(last){app.bank=last.bank;app.year=last.year}toast(r.message);await refresh();
 }catch(e){const f=$('#pdf-commit-feedback');if(f)f.textContent=e.message;toast(e.message,true)}finally{if($('#pdf-commit'))$('#pdf-commit').disabled=false}
}

