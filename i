/* Scenario-only presentation; no rules for other application pages. */
.scenario-layout{align-items:start}
.scenario-settings,.scenario-results{min-height:390px}
.scenario-results .table-wrap table{min-width:0}.scenario-results .table-wrap th,.scenario-results .table-wrap td{padding:11px 10px}
.scenario-intro{color:#6c8192;font-size:12px;line-height:1.7;margin:8px 0 19px}
.scenario-fields{display:grid;gap:16px}
.scenario-control{border:1px solid #dfebe8;border-radius:15px;background:linear-gradient(145deg,#fbfefd 0%,#f5faf9 100%);padding:18px 19px 16px;transition:border-color .18s}
.scenario-control:focus-within{border-color:#9bcfc3}
.scenario-control-head{display:flex;align-items:start;justify-content:space-between;gap:12px}
.scenario-label{display:block;color:#203a4d;font-size:13px;font-weight:790;line-height:1.5}
.scenario-description{font-size:11px;color:#8598a4;margin:4px 0 0;line-height:1.6}
.scenario-preview{display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;min-width:78px;padding:7px 10px;border-radius:9px;color:#087e78;background:#e0f4ee;border:1px solid #cdebe2;font-size:15px;font-weight:800;font-variant-numeric:tabular-nums}
.scenario-track-wrap{position:relative;display:flex;align-items:center;margin:22px 4px 8px;height:20px}
.scenario-slider{position:relative;z-index:2;appearance:none;-webkit-appearance:none;width:100%;height:7px;border-radius:999px;outline:none;background:linear-gradient(to right,#0b8980 0%,#0b8980 var(--slider-fill),#dce9e7 var(--slider-fill),#dce9e7 100%);cursor:pointer;touch-action:pan-y}
.scenario-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;height:21px;width:21px;border:4px solid #fff;border-radius:50%;background:#087e78;box-shadow:0 1px 8px rgba(10,79,76,.28),0 0 0 1px #a9cdc5;cursor:grab}
.scenario-slider::-moz-range-thumb{height:13px;width:13px;border:4px solid #fff;border-radius:50%;background:#087e78;box-shadow:0 1px 8px rgba(10,79,76,.28);cursor:grab}
.scenario-slider:active::-webkit-slider-thumb{cursor:grabbing}
.scenario-slider:focus-visible{outline:2px solid #0b8980;outline-offset:6px}
.scenario-neutral{position:absolute;z-index:1;top:0;bottom:0;border-left:1px dashed #93a9a4;pointer-events:none}
.scenario-scale{position:relative;height:16px;color:#8496a3;font-size:10px;font-weight:700;font-variant-numeric:tabular-nums}.scenario-scale>span{position:absolute;top:0;white-space:nowrap}.scenario-scale>span:first-child{left:0}.scenario-scale>span:nth-child(2){transform:translateX(-50%)}.scenario-scale>span:last-child{right:0}
.scenario-manual-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:19px;padding-top:14px;border-top:1px solid #e4eeeb}
.scenario-manual-row>label{font-size:11.5px;color:#597488;font-weight:650}
.scenario-number{display:flex;align-items:center;border:1px solid #cfdfdf;border-radius:10px;background:#fff;overflow:hidden;min-width:108px;box-shadow:0 1px 3px rgba(16,55,60,.03)}
.scenario-number:focus-within{border-color:#3f9e90;box-shadow:0 0 0 3px rgba(14,129,117,.1)}
.scenario-number input{width:80px;min-width:0;border:0;padding:9px 9px 9px 10px;color:#143246;font-size:15px;line-height:1.2;font-weight:750;font-variant-numeric:tabular-nums;text-align:right;background:transparent;outline:none}
.scenario-number span{font-size:12px;color:#728c98;font-weight:750;margin:0 12px 0 2px}
.scenario-number:has(input[aria-invalid=true]){border-color:#c77c68}
.scenario-error{font-size:11px;line-height:1.45;color:#ab5542;min-height:0;margin:0}
.scenario-error:not(:empty){margin-top:8px}
.scenario-run{width:100%;justify-content:center;margin-top:18px;min-height:45px;font-size:12px}
.scenario-footnote{line-height:1.7;text-align:center;margin:11px 0 0}
@media(max-width:510px){.scenario-control{padding:15px}.scenario-control-head{gap:8px}.scenario-preview{min-width:68px;font-size:13px}.scenario-manual-row{flex-wrap:wrap}.scenario-number{margin-left:auto}}

.compare-toolbar{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin-bottom:16px}
.compare-toolbar .field{min-width:240px;max-width:340px}
.compare-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:18px;margin-bottom:18px}
.compare-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
