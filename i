/* Scenario-only presentation; no rules for other application pages. */
.scenario-layout{align-items:start}
.scenario-settings,.scenario-results{min-height:390px}
.scenario-results .table-wrap table{min-width:0}.scenario-results .table-wrap th,.scenario-results .table-wrap td{padding:11px 10px}
.scenario-intro{color:#6c8192;font-size:12px;line-height:1.7;margin:8px 0 19px}
.scenario-fields{display:grid;gap:16px}
.scenario-control{border:1px solid #dfebe8;border-radius:15px;background:linear-gradient(145deg,#fbfefd 0%,#f5faf9 100%);padding:18px 19px 16px;transition:border-color .18s}
