.compare-legend{display:grid;gap:8px}.compare-legend .row{display:flex;justify-content:space-between;gap:10px;font-size:13px}.compare-legend .label{display:flex;align-items:center;gap:8px;color:#17324d;font-weight:600}.compare-legend .dot{width:10px;height:10px;border-radius:50%}.compare-legend .dot.vcb{background:#11a394}.compare-legend .dot.bidv{background:#264d71}
.dataset-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:8px 0 18px}.dataset-card{background:#f8fbfc;border:1px solid #e3ecf1;border-radius:14px;padding:14px 16px}.dataset-card small{display:block;color:#7a8a9a;font-size:12px;margin-bottom:7px}.dataset-card strong{font-size:22px;color:#17324d}
.upload-panel .drop{min-height:138px}.file-chip{display:inline-flex;align-items:center;gap:8px;background:#eef7f6;border:1px solid #d6ece8;color:#0f6e65;padding:8px 12px;border-radius:999px;font-size:12px;font-weight:700;margin-top:10px}
